    {
      "name": "Search & Filters",
      "item": [
        {
          "name": "Global Search & Filtering",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/{{companySlug}}/manager/search?query=Financial&fileType=PDF&status=Active&sortBy=uploadDate&order=desc&page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "{{companySlug}}", "manager", "search"],
              "query": [
                { "key": "query", "value": "Financial", "description": "Matches name, tags, description" },
                { "key": "fileType", "value": "PDF", "description": "e.g., PDF, DOCX, XLSX" },
                { "key": "status", "value": "Active", "description": "e.g. Active, Archived" },
                { "key": "isFavorite", "value": "true", "disabled": true },
                { "key": "isArchived", "value": "false", "disabled": true },
                { "key": "isLocked", "value": "false", "disabled": true },
                { "key": "sortBy", "value": "uploadDate", "description": "name, uploadDate, modifiedDate, fileSize, fileType" },
                { "key": "order", "value": "desc", "description": "asc or desc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
